{
  "manifest_version": 3,
  "name": "OpenAudio Tabs",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "description": "Independent volume and output for tabs you activate in OpenAudio.",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Control this tab in OpenAudio"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "description": "Control the current tab in OpenAudio"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
